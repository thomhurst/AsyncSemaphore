<Project Sdk="Microsoft.NET.Sdk">

    <!--
      One run per framework the library builds for: each picks up the matching library build, and the
      node-recycling proof in the library leans on Timer.DisposeAsync behavior that has to hold on
      every runtime it ships for. The netstandard2.0 build is covered by AsyncSemaphore.UnitTests.NetStandard.
    -->
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.69.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AsyncSemaphore.Analyzers\AsyncSemaphore.Analyzers\AsyncSemaphore.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
      <ProjectReference Include="..\AsyncSemaphore\AsyncSemaphore.csproj" />
    </ItemGroup>

</Project>
