<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0; net8.0; net9.0; net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Semaphores</RootNamespace>
        <Version>99</Version>
        <AnalyzerProject>..\AsyncSemaphore.Analyzers\AsyncSemaphore.Analyzers\AsyncSemaphore.Analyzers.csproj</AnalyzerProject>
    </PropertyGroup>

    <!--
      PrivateAssets="all" keeps AsyncSemaphore.Analyzers out of the produced package's
      dependency list. The analyzer assembly itself is packed below under analyzers/dotnet/cs,
      which is the only folder NuGet loads analyzers from.
    -->
    <ItemGroup>
        <ProjectReference Include="$(AnalyzerProject)"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
    </ItemGroup>

    <PropertyGroup>
        <BeforePack>$(BeforePack);IncludeAnalyzerInPackage</BeforePack>
    </PropertyGroup>

    <Target Name="IncludeAnalyzerInPackage">
        <MSBuild Projects="$(AnalyzerProject)"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="AnalyzerPackageAssembly"/>
        </MSBuild>
        <ItemGroup>
            <None Include="@(AnalyzerPackageAssembly)"
                  Pack="true"
                  PackagePath="analyzers/dotnet/cs"
                  Visible="false"/>
        </ItemGroup>
    </Target>

    <!-- Lets the tests read the waiter debt, so they can tell a wait has queued instead of inferring it from timing. -->
    <ItemGroup>
      <InternalsVisibleTo Include="AsyncSemaphore.UnitTests" />
      <InternalsVisibleTo Include="AsyncSemaphore.UnitTests.NetStandard" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <!-- Compatibility floors for ValueTask and ManualResetValueTaskSourceCore<T>.
           Keep these low so consumers can retain their own dependency pins (#583).
           Modern .NET targets provide these types in the framework. -->
      <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
      <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="6.0.0" />
    </ItemGroup>

</Project>
